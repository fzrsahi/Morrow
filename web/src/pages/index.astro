---
// Astro's BASE_URL is "/Morrow" here; normalise it so local assets resolve
// under the project pages URL instead of collapsing into "/Morrowassets/...".
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<!doctype html>
<html lang="en" data-type="software" data-site-kind="software" data-page-type="software" data-radius="soft" data-buttons="pill" data-motion data-theme="pixel">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="site-kind" content="software"><meta name="page-type" content="software"><title>Morrow — one island for every coding agent</title><meta name="description" content="Morrow shows Claude Code, Codex, Gemini and other agent sessions in a notch on macOS, Linux and Windows. Approve prompts, see playback and read status from one panel."><meta property="og:title" content="Morrow — one island for every coding agent"><meta property="og:description" content="The same agent session, approval and playback panel across macOS, Linux and Windows."><meta property="og:type" content="website"><link rel="icon" href={base + 'assets/logo.svg'} type="image/svg+xml"><meta name="theme-color" content="#eeeeeb"><script>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..700&family=Figtree:wght@400..600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"><link rel="stylesheet" href={base + 'assets/system.css'}><link rel="stylesheet" href={base + 'assets/ui/cards.css'}><link rel="stylesheet" href={base + 'assets/motion/motion.css'}><link rel="stylesheet" href={base + 'assets/backgrounds/backgrounds.css'}><link rel="stylesheet" href={base + 'assets/layout/layout.css'}><link rel="stylesheet" href={base + 'assets/icons/icon.css'}><link rel="stylesheet" href={base + 'assets/moments/liquid-type/moment.css'}><link rel="stylesheet" href={base + 'assets/site-inline.css'}>
</head>
<body>
<header class="nav nav--centre" id="top"> <div class="wrap nav__bar"> <a class="skip-link" href="#main">Skip to content</a> <a class="nav__logo" href="#top"><span class="mark" data-mark="dots" aria-hidden="true"></span>Morrow</a> <nav class="nav__links" aria-label="Main"> <span class="nav__item"><a class="nav__link" href="#what">What it shows</a></span> <span class="nav__item"><a class="nav__link" href="#platforms">Platforms</a></span> <span class="nav__item"><a class="nav__link" href="#download">Download</a></span> </nav> <div class="nav__actions"> <div class="theme-switch" role="group" aria-label="Island theme"> <button type="button" data-theme-set="pixel" aria-pressed="true">Pixel</button> <button type="button" data-theme-set="modern" aria-pressed="false">Modern</button> </div> </div> </div> </header> <main id="main"> <section class="hero hero--split" style="--h: 1" data-enter aria-labelledby="hero-h"> <div class="wrap"> <div class="hero-text grid hero-split"> <div class="hero-copy span-5"> <p class="hero-notice">macOS · Linux · Windows</p> <h1 id="hero-h">Notch panel for coding agents.</h1> <p class="t-lead hero__lead">Morrow puts your coding agents in the notch. See Claude Code, Codex and Gemini work, approve prompts and follow playback from one panel.</p> <div class="btn-row"> <a class="btn btn--primary" href="https://github.com/fzrsahi/Morrow/releases">See releases</a> <a class="btn btn--secondary" href="https://github.com/fzrsahi/Morrow#readme">Read the docs</a> </div> </div> <div class="hero-visual span-6 start-7"> <img src={base + 'shots/hero-island.svg'} alt="Morrow's notch panel with three live agent sessions: Claude Code reading a file, Codex waiting for approval, Gemini writing tests, and a playback line in the right wing" width="1200" height="1360"> <div class="hero-fact"> <p>3 sessions live · right wing tracks playback</p> </div> </div> </div> </div> </section> <section class="section" id="what" style="--h: 1; --hm: 2"> <div class="wrap"> <div class="section-head"> <h2>The notch panel</h2> <p>One panel for the agent sessions you already run.</p> </div> <div class="fill cards-fill"> <div class="what-copy"> <div class="what-item"> <h3>Session rows</h3> <p>Claude Code, Codex and Gemini sessions appear in the notch with their current status.</p> </div> <div class="what-item"> <h3>Approval card</h3> <p>Permission prompts land in the panel. Approve or deny there; the tool call keeps its real result.</p> </div> <div class="what-item"> <h3>Music wing</h3> <p>The right wing follows the current track with a progress line and lyrics.</p> </div> </div> <div class="what-shot"> <img src={base + 'shots/approval.svg'} alt="An approval prompt in the Morrow panel with Approve and Deny buttons" width="1200" height="900"> </div> </div> </div> </section> <section class="section" id="platforms" style="--h: 1"> <div class="wrap"> <div data-moment="liquid-type" class="section-head" style="max-width:none"> <h2 class="mo-lt__type">Morrow on macOS, Linux, Windows.</h2> <p>The hook contract, fixtures and capability table are shared across every desktop. When an OS cannot do something, Morrow shows the reason instead of failing quietly.</p> </div> <img class="statement-shot" src={base + 'shots/cross-platform.svg'} alt="Two flat vector Morrow panel mocks side by side: Linux with X11 tools xdotool, xprop and playerctl, and Windows with WinRT, SendKeys and a named pipe; both show supported capabilities and a shared hook contract." width="1600" height="900"> </div> </section> </main> <footer class="footer closing footer--dark" id="download" style="--h: 1"> <div class="wrap"> <div class="closing__cta close--type"> <div class="section-head"> <h2>Download Morrow</h2> <p>Packages ship for every desktop the panel runs on.</p> </div> <div class="btn-row"> <a class="btn btn--primary" href="https://github.com/fzrsahi/Morrow/releases">Get the installers</a> <a class="btn btn--secondary" href="https://github.com/fzrsahi/Morrow">Browse the source</a> </div> <img src={base + 'shots/music.svg'} alt="The Morrow music wing showing Now playing artwork for Nightshift, an audio visualizer, a progress bar and the time 03:12 / 07:44" width="1200" height="900"> </div> <div class="footer__bottom"> <a class="nav__logo" href="#top"><span class="mark" data-mark="dots" aria-hidden="true"></span>Morrow</a> <p class="footer__credits">Illustrative panel artwork.</p> </div> </div> </footer>  <script is:inline>
    const root = document.documentElement;
    for (const b of document.querySelectorAll('[data-theme-set]')) {
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme));
      b.addEventListener('click', () => {
        root.dataset.theme = b.dataset.themeSet;
        for (const o of document.querySelectorAll('[data-theme-set]')) o.setAttribute('aria-pressed', String(o === b));
        localStorage.setItem('morrow-theme', b.dataset.themeSet);
      });
    }
    const saved = localStorage.getItem('morrow-theme');
    if (saved) { root.dataset.theme = saved; for (const b of document.querySelectorAll('[data-theme-set]')) b.setAttribute('aria-pressed', String(b.dataset.themeSet === saved)); }
  </script> <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script> <script type="module" src={base + 'assets/moments/moments.js'} is:inline></script>
</body>
</html>
