<!doctype html>
<!-- Plan: software · hero triptych as a notch island · palette charcoal-room-sage (dark neutral answers the dark menu bar and app screenshots) · type geist · nav-cards · footer-columns · close-word · surface-pairs · arrow buttons · stack mark · one moment: letters-assemble. -->
<html lang="en" data-type="software" data-site-kind="software" data-page-type="software" data-radius="sharp" data-buttons="arrow" data-motion data-theme="pixel">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="site-kind" content="software" />
  <meta name="page-type" content="software" />
  <title>Morrow — one island for every coding agent</title>
  <meta name="description" content="Morrow shows Claude Code, Codex, Gemini and other agent sessions in a notch on macOS, Linux and Windows. Approve prompts, see playback and read status from one panel." />
  <meta property="og:title" content="Morrow — one island for every coding agent" />
  <meta property="og:description" content="The same agent session, approval and playback panel across macOS, Linux and Windows." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="assets/logo.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#1c1c1c" />
  <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="assets/system.css" />
  <link rel="stylesheet" href="assets/ui/cards.css" />
  <link rel="stylesheet" href="assets/motion/motion.css" />
  <link rel="stylesheet" href="assets/backgrounds/backgrounds.css" />
  <link rel="stylesheet" href="assets/layout/layout.css" />
  <link rel="stylesheet" href="assets/icons/icon.css" />
  <link rel="stylesheet" href="assets/moments/letters-assemble/moment.css" />
  <style is:global>
    :root {
      --p-bg: #1c1c1c; --p-surface: #262626; --p-ink: #f1f1ef; --p-muted: #9a9b96;
      --p-accent: #8fa68e; --p-accent-ink: #1c1c1c; --p-action: #8fa68e; --p-action-ink: #1c1c1c;
      --p-inv-bg: #c8c5ba; --p-inv-surface: #bab8ae; --p-inv-ink: #1c1c1c; --p-inv-muted: #454442;
      --p-inv-accent: #1c1c1c; --p-inv-accent-ink: #c8c5ba; --p-inv-action: #1c1c1c; --p-inv-action-ink: #c8c5ba;
      --font-display: "Geist", system-ui, sans-serif;
      --font-text: "Geist", system-ui, sans-serif;
      --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      --display-weight: 500;
      --display-tracking: -0.035em;
      --display-tracking-xl: -0.045em;
      --notch-radius: 18px;
    }
    html[data-theme="modern"] {
      --p-surface: #1f2328; --p-accent: #9fb6c8; --p-action: #9fb6c8; --notch-radius: 26px;
    }
    .nav { background: var(--p-bg); }
    .nav__bar {
      position: relative; height: 64px; margin-top: 10px; padding-inline: 0;
      background: var(--p-surface); border: 1px solid color-mix(in oklab, var(--p-ink) 12%, transparent);
      border-radius: var(--notch-radius); padding-inline: var(--s-5);
      box-shadow: 0 18px 40px -28px rgb(0 0 0 / .8);
    }
    .nav__bar::before {
      content: ""; position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
      width: 132px; height: 13px; background: var(--p-bg);
      border-radius: 0 0 9px 9px; border-inline: 1px solid color-mix(in oklab, var(--p-ink) 12%, transparent);
    }
    .theme-switch { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; }
    .theme-switch button { display: inline-flex; align-items: center; min-height: 44px; background: none; border: 0; color: var(--muted); font: 500 12px/1 var(--font-text); padding: 0 11px; border-radius: 999px; cursor: pointer; }
    .theme-switch button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
    .hero-text { align-items: center; height: 100%; }
    .hero-copy { display: grid; gap: var(--s-4); }
    .hero-action { display: flex; justify-content: flex-end; }
    .hero-island { position: relative; width: 100%; height: 100%; min-height: 0; }
    .hero-island::before {
      content: ""; position: absolute; z-index: 3; top: 0; left: 50%; transform: translateX(-50%);
      width: 116px; height: 12px; background: var(--p-bg); border-radius: 0 0 8px 8px;
    }
    .hero-island .main-shot, .hero-island .small-shot {
      position: absolute; display: block; object-fit: cover; border-radius: var(--notch-radius);
      border: 1px solid color-mix(in oklab, var(--p-ink) 14%, transparent);
    }
    .hero-island .main-shot { inset: 10px 0 0; width: 100%; height: calc(100% - 10px); }
    .hero-island .small-shot { width: 42%; height: 36%; right: 0; bottom: 0; z-index: 2; }
    .hero-island .small-shot.second { right: auto; left: 0; bottom: 10%; width: 36%; height: 28%; }
    .cards-fill { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-self: stretch; align-items: start; }
    .cards-fill > .what-copy { grid-column: 1 / span 6; display: grid; gap: var(--s-6); }
    .what-item h3 { margin: 0 0 var(--s-2); } .what-item p { margin: 0; }
    .cards-fill > .what-shot { grid-column: 7 / -1; align-self: stretch; }
    .what-shot img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--notch-radius); }
    .closing__cta { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--gutter); align-items: start; }
    .closing__cta > .section-head { grid-column: 1; }
    .closing__cta > .btn-row { grid-column: 1; }
    .closing__cta > img { grid-column: 2; grid-row: 1 / span 2; max-height: 420px; width: 100%; object-fit: cover; border-radius: var(--notch-radius); }
    .statement { border-block: 1px solid var(--line); }
    .statement .fill { display: grid; align-content: center; }
    .mo-la__type { font: 500 clamp(40px, 7vw, 96px)/1.02 var(--font-display); letter-spacing: var(--display-tracking-xl); }
    .mo-la__sub { color: var(--ink); }
    .statement-shot { width: 100%; height: 260px; object-fit: cover; border-radius: var(--notch-radius); }
    .footer__credits { color: var(--muted); font-size: var(--t-small); }
    @media (max-width: 639px) {
      .nav__links { display: none; } .nav__bar { padding-inline: var(--s-4); } .nav__bar > .btn { display: none; }
      .cards-fill { grid-template-columns: 1fr; }
      .cards-fill > .what-copy, .cards-fill > .what-shot { grid-column: 1; }
      .what-shot img { max-height: 320px; }
      .hero-island .small-shot.second { display: none; }
      .closing__cta { grid-template-columns: 1fr; }
      .closing__cta > img { grid-column: 1; grid-row: auto; max-height: 260px; }
    }
  </style>
</head>
<body>
  <slot />
  <script is:inline>
    const root = document.documentElement;
    for (const b of document.querySelectorAll('[data-theme-set]')) {
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme));
      b.addEventListener('click', () => {
        root.dataset.theme = b.dataset.themeSet;
        for (const o of document.querySelectorAll('[data-theme-set]')) o.setAttribute('aria-pressed', String(o === b));
        localStorage.setItem('morrow-theme', b.dataset.themeSet);
      });
    }
    const saved = localStorage.getItem('morrow-theme');
    if (saved) { root.dataset.theme = saved; for (const b of document.querySelectorAll('[data-theme-set]')) b.setAttribute('aria-pressed', String(b.dataset.themeSet === saved)); }
  </script>
  <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
  <script type="module" src="assets/moments/moments.js"></script>
</body>
</html>
