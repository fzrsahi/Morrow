---
---
<!doctype html>
<html lang="en" data-type="software" data-site-kind="software" data-page-type="software" data-radius="sharp" data-buttons="arrow" data-motion>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="site-kind" content="software" />
  <meta name="page-type" content="software" />
  <title>Morrow — one island for every coding agent</title>
  <meta name="description" content="Morrow shows Claude Code, Codex, Gemini and other agent sessions in a notch on macOS, Linux and Windows. Approve prompts, see playback and read status from one panel." />
  <meta property="og:title" content="Morrow — one island for every coding agent" />
  <meta property="og:description" content="The same agent session, approval and playback panel across macOS, Linux and Windows." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="assets/logo.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#000000" />
  <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chivo:wght@400..700&family=Chivo+Mono:wght@400..500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="assets/system.css" />
  <link rel="stylesheet" href="assets/ui/cards.css" />
  <link rel="stylesheet" href="assets/motion/motion.css" />
  <link rel="stylesheet" href="assets/backgrounds/backgrounds.css" />
  <link rel="stylesheet" href="assets/layout/layout.css" />
  <link rel="stylesheet" href="assets/icons/icon.css" />
  <link rel="stylesheet" href="assets/moments/word-highlight/moment.css" />
  <style is:global>
    :root {
      --p-bg: #000000; --p-surface: #0d0d0d; --p-ink: #ffffff; --p-muted: #999999;
      --p-accent: #93f1f7; --p-accent-ink: #000000; --p-action: #93f1f7; --p-action-ink: #000000;
      --p-inv-bg: #9ae187; --p-inv-surface: #8bcc7a; --p-inv-ink: #000000; --p-inv-muted: #24391e;
      --p-inv-accent: #000000; --p-inv-accent-ink: #9ae187; --p-inv-action: #000000; --p-inv-action-ink: #9ae187;
      --font-display: "Chivo", system-ui, sans-serif;
      --font-text: "Chivo", system-ui, sans-serif;
      --font-mono: "Chivo Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      --display-weight: 400;
      --display-tracking: -0.03em;
      --display-tracking-xl: -0.04em;
      --ly-scale: 0.96;
    }
    .hero__visual img, .card__shot img, .closing__cta img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--r-lg); }
    .hero__visual { align-self: stretch; min-height: 0; }
    .cards-fill { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-self: stretch; align-items: start; }
    .cards-fill > .what-copy { grid-column: 1 / span 6; display: grid; gap: var(--s-6); } .what-item h3 { margin: 0 0 var(--s-2); } .what-item p { margin: 0; }
    .cards-fill > .what-shot { grid-column: 7 / -1; align-self: stretch; } .what-shot img { height: 100%; max-height: 560px; }
    .statement .fill { display: grid; align-content: center; }
    .statement { border-block: 1px solid var(--line); }
    .mo-wh__text { font: 400 clamp(28px, 4vw, 52px)/1.18 var(--font-display); letter-spacing: var(--display-tracking-xl); }
    .closing__cta { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--gutter); align-items: start; }
    .closing__cta > .section-head { grid-column: 1; }
    .closing__cta > .btn-row { grid-column: 1; }
    .closing__cta > img { grid-column: 2; grid-row: 1 / span 2; max-height: 420px; }
    .footer__credits { color: var(--muted); font-size: var(--t-small); }
    @media (max-width: 639px) {
      .cards-fill { grid-template-columns: 1fr; } .cards-fill > .what-copy, .cards-fill > .what-shot { grid-column: 1; } .what-shot { display: block; } .what-shot img { max-height: 320px; }
      .hero__visual { display: none; }
      .closing__cta { grid-template-columns: 1fr; }
      .closing__cta > img { grid-column: 1; grid-row: auto; max-height: 260px; }
    }
  </style>
</head>
<body>
  <slot />
  <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
  <script type="module" src="assets/moments/moments.js"></script>
</body>
</html>
