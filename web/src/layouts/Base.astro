<!doctype html>
<!-- Plan: software · hero split · steel-orange (stone ground + orange accent makes the dark notch read as an object) · gabarito · nav-centre · footer-dark · close-type · brand-band · pill buttons · dots mark · one moment: liquid-type. -->
<html lang="en" data-type="software" data-site-kind="software" data-page-type="software" data-radius="soft" data-buttons="pill" data-motion data-theme="pixel">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="site-kind" content="software" />
  <meta name="page-type" content="software" />
  <title>Morrow — one island for every coding agent</title>
  <meta name="description" content="Morrow shows Claude Code, Codex, Gemini and other agent sessions in a notch on macOS, Linux and Windows. Approve prompts, see playback and read status from one panel." />
  <meta property="og:title" content="Morrow — one island for every coding agent" />
  <meta property="og:description" content="The same agent session, approval and playback panel across macOS, Linux and Windows." />
  <meta property="og:type" content="website" />
  <link rel="icon" href="assets/logo.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#eeeeeb" />
  <script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..700&family=Figtree:wght@400..600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="assets/system.css" />
  <link rel="stylesheet" href="assets/ui/cards.css" />
  <link rel="stylesheet" href="assets/motion/motion.css" />
  <link rel="stylesheet" href="assets/backgrounds/backgrounds.css" />
  <link rel="stylesheet" href="assets/layout/layout.css" />
  <link rel="stylesheet" href="assets/icons/icon.css" />
  <link rel="stylesheet" href="assets/moments/liquid-type/moment.css" />
  <style is:global>
    :root {
      --p-bg: #eeeeeb; --p-surface: #e1e1dd; --p-ink: #1c1d1f; --p-muted: #5c5e62;
      --p-accent: #c2501b; --p-accent-ink: #ffffff; --p-action: #c2501b; --p-action-ink: #ffffff;
      --p-inv-bg: #1c1d1f; --p-inv-surface: #28292b; --p-inv-ink: #eeeeeb; --p-inv-muted: #969796;
      --p-inv-accent: #c2501b; --p-inv-accent-ink: #ffffff; --p-inv-action: #c2501b; --p-inv-action-ink: #ffffff;
      --font-display: "Gabarito", system-ui, sans-serif;
      --font-text: "Figtree", system-ui, sans-serif;
      --font-mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      --display-weight: 500;
      --display-tracking: -0.03em;
      --display-tracking-xl: -0.04em;
      --ly-scale: 0.98;
      --notch-radius: var(--r-lg);
    }
    html[data-theme="modern"] { --p-surface: #d8d6d1; --p-accent: #256f82; --p-action: #256f82; }
    .nav { background: var(--p-bg); }
    .nav__bar { position: relative; height: 100%; margin-top: 0; padding-inline: 0; }
    .nav__bar::before { content: ""; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 124px; height: 12px; background: var(--p-bg); border-radius: 0 0 8px 8px; }
    .theme-switch { display: flex; gap: 2px; padding: 0; border: 0; box-shadow: inset 0 0 0 1px var(--line); border-radius: 999px; }
    .theme-switch button { display: inline-flex; align-items: center; min-height: 44px; background: none; border: 0; color: var(--muted); font: 500 12px/1 var(--font-text); padding: 0 11px; border-radius: 999px; cursor: pointer; }
    .theme-switch button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
    .hero-text { align-items: start; height: 100%; }
    .hero-copy { display: grid; gap: var(--s-4); }
    .hero-visual { position: relative; align-self: stretch; min-height: 0; }
    .hero-visual img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--notch-radius); }
    .hero-fact { position: absolute; left: 24px; bottom: 24px; width: 300px; padding: 16px; background: var(--p-surface); border: 1px solid var(--line); border-radius: var(--notch-radius); }
    .cards-fill { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-self: stretch; align-items: start; }
    .cards-fill > .what-copy { grid-column: 1 / span 5; display: grid; gap: var(--s-6); }
    .cards-fill > .what-shot { grid-column: 7 / -1; align-self: stretch; }
    .cards-fill img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--notch-radius); }
    .mo-lt__type { font: 500 clamp(40px, 6vw, 84px)/1.03 var(--font-display); letter-spacing: var(--display-tracking-xl); }
    .statement-shot { display: block; width: 100%; height: 280px; object-fit: cover; object-position: 50% 0; border-radius: var(--notch-radius); }
    .closing__cta { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--gutter); align-items: start; }
    .closing__cta > .section-head { grid-column: 1; }
    .closing__cta > .btn-row { grid-column: 1; }
    .closing__cta > img { grid-column: 2; grid-row: 1 / span 2; width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--notch-radius); }
    .footer__credits { color: var(--muted); font-size: var(--t-small); }
    @media (max-width: 639px) {
      .nav__links { display: none; }
      .nav__bar > .btn { display: none; }
      .cards-fill { grid-template-columns: 1fr; }
      .cards-fill > .what-copy, .cards-fill > .what-shot { grid-column: 1; }
      .cards-fill img { max-height: 320px; }
      .closing__cta { grid-template-columns: 1fr; }
      .closing__cta > img { grid-column: 1; grid-row: auto; max-height: 260px; }
    }
  </style>
</head>
<body>
  <slot />
  <script is:inline>
    const root = document.documentElement;
    for (const b of document.querySelectorAll('[data-theme-set]')) {
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme));
      b.addEventListener('click', () => {
        root.dataset.theme = b.dataset.themeSet;
        for (const o of document.querySelectorAll('[data-theme-set]')) o.setAttribute('aria-pressed', String(o === b));
        localStorage.setItem('morrow-theme', b.dataset.themeSet);
      });
    }
    const saved = localStorage.getItem('morrow-theme');
    if (saved) { root.dataset.theme = saved; for (const b of document.querySelectorAll('[data-theme-set]')) b.setAttribute('aria-pressed', String(b.dataset.themeSet === saved)); }
  </script>
  <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
  <script type="module" src="assets/moments/moments.js"></script>
</body>
</html>
