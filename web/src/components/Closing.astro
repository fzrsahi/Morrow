---
const releases = 'https://github.com/fzrsahi/Morrow/releases';
---
<footer class="footer closing" id="download" style="--h: 1">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head">
        <p class="t-stat">Download Morrow</p>
        <p>Releases publish the built macOS disk image and the Linux and Windows packages.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={releases}>See all releases</a>
        <a class="btn btn--secondary" href="https://github.com/fzrsahi/Morrow">Browse the source</a>
      </div>
      <img src="images/readme-approval-zh.png" alt="The Morrow approval card in another interface language" width="1200" height="800" />
    </div>
    <div class="footer__bottom">
      <a class="nav__logo" href="#top"><span class="mark" data-mark="stack" aria-hidden="true"></span>Morrow</a>
      <p class="footer__credits">Interface images come from the Morrow repository.</p>
    </div>
  </div>
</footer>
