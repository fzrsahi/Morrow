#!/bin/sh
# Morrow Local Pre-Push Verification Hook
# Catches compiler timeouts, syntax errors, and unit test regressions before code is pushed.

ROOT="$(git rev-parse --show-toplevel)"

# Frontend gate: lint, type check, bun test, vite build. A checkout without bun
# or without installed deps is skipped with a notice, the same way a missing
# 'swift' skips the SwiftPM gate below.
if command -v bun >/dev/null 2>&1 && [ -d "$ROOT/shared/desktop/node_modules" ]; then
    echo "==> [Pre-Push Hook] Verifying desktop shell (lint, types, tests, build)..."
    if ! ( cd "$ROOT" && ./shared/ci/desktop-check.sh ); then
        echo ""
        echo "❌ [Pre-Push Error] Desktop shell check failed!"
        echo "👉 Fix the FAIL lines above, or run './shared/ci/desktop-check.sh' for the full log."
        exit 1
    fi
else
    echo "==> [Pre-Push Hook] 'bun' or shared/desktop/node_modules missing. Skipping desktop shell check."
fi

if [ -d /Applications/Xcode.app/Contents/Developer ]; then
    export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi

if ! command -v swift >/dev/null 2>&1; then
    echo "==> [Pre-Push Hook] 'swift' not found in PATH. Skipping local SwiftPM verification."
    exit 0
fi

# The Swift package lives in macos/ (hooks run from the repo root).
cd "$ROOT/macos" || exit 1

echo "==> [Pre-Push Hook] Verifying build & unit tests locally..."
if ! swift build --build-tests -q; then
    echo ""
    echo "❌ [Pre-Push Error] Build or unit tests failed!"
    echo "👉 Please fix compilation or test failures locally before pushing to remote."
    echo "💡 Run 'cd macos && swift build --build-tests' to view full compiler logs."
    exit 1
fi

echo "✅ [Pre-Push Hook] Verification passed. Proceeding with push."
exit 0
