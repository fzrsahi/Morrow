[Unit]
Description=Morrow Woodpecker Runner Token Self-Healing Watchdog
After=docker.service network-online.target

[Service]
Type=oneshot
# Adjust ExecStart to your repository location or symlink scripts/setup-linux-runner.sh to /usr/local/bin/
ExecStart=/usr/local/bin/setup-linux-runner.sh --check-heal
StandardOutput=journal
StandardError=journal

